{
    "version": 1,
    "name": "oc1-esp32s3",
    "displayName": "OC1 ESP32-S3 Card",
    "mcu": "esp32s3",
    "clock": {
        "sysHz": 240000000
    },
    "flash": {
        "method": "esptool",
        "sizeKB": 8192
    },
    "pins": [
        { "pin": 0, "label": "BOOT_BTN", "signal": "gpio_in", "pull": "up" },
        { "pin": 1, "label": "AIN0", "signal": "adc0" },
        { "pin": 8, "label": "I2C_SDA", "signal": "i2c0_sda", "pull": "up" },
        { "pin": 9, "label": "I2C_SCL", "signal": "i2c0_scl", "pull": "up" },
        { "pin": 10, "label": "SPI_CS", "signal": "gpio_out", "initial": "high" },
        { "pin": 11, "label": "SPI_MOSI", "signal": "spi2_tx" },
        { "pin": 12, "label": "SPI_SCK", "signal": "spi2_sck" },
        { "pin": 13, "label": "SPI_MISO", "signal": "spi2_rx" },
        { "pin": 43, "label": "DEBUG_TX", "signal": "uart0_tx" },
        { "pin": 44, "label": "DEBUG_RX", "signal": "uart0_rx" },
        { "pin": 47, "label": "BUZZER", "signal": "pwm0_a" },
        { "pin": 48, "label": "STATUS_LED", "signal": "gpio_out", "initial": "low" }
    ],
    "peripherals": [
        { "kind": "uart", "id": "uart0", "baud": 115200, "tx": "DEBUG_TX", "rx": "DEBUG_RX" },
        { "kind": "i2c", "id": "i2c0", "sda": "I2C_SDA", "scl": "I2C_SCL", "freqHz": 400000 },
        { "kind": "spi", "id": "spi2", "sck": "SPI_SCK", "mosi": "SPI_MOSI", "miso": "SPI_MISO", "freqHz": 1000000 },
        { "kind": "pwm", "id": "pwm0", "pin": "BUZZER", "freqHz": 2000 },
        { "kind": "adc", "id": "adc0", "pin": "AIN0" }
    ],
    "leds": [
        { "name": "LED_BUILTIN", "label": "STATUS_LED", "activeLow": false }
    ]
}
