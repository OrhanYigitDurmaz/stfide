{
    "compilerOptions": {
        "skipLibCheck": true,
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitThis": true,
        "noEmitOnError": false,
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "esModuleInterop": true,
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "lib"
    },
    "include": [
        "src"
    ]
}
