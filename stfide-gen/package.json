{
  "name": "stfide-gen",
  "version": "0.0.0",
  "private": true,
  "description": "Board configuration code generator for custom RP2040 / ESP32-S3 cards",
  "bin": {
    "stfide-gen": "./lib/cli.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "prepare": "npm run clean && npm run build",
    "clean": "rimraf lib",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "npm run build && node --test lib/test/"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.4.5"
  }
}
