// STF dili: düğmeye basış sayısını EEPROM'a kaydeder; kart kapanıp açılınca da hatırlar.

kütüphane eeprom

sayı sayaç = 0

kur
    sayaç = EEPROM.oku(0)   // bir EEPROM hücresi 0-255 tutar
    yaz("Kayıtlı basış: ", sayaç)
son

döngü
    eğer basılı_mı(düğme) ise
        sayaç++
        EEPROM.kaydet(0, sayaç)   // sadece değişince yazar, EEPROM'u yıpratmaz
        yaz("Basış: ", sayaç)
        yak(led)
        bekle(300)
        söndür(led)
    son
son
